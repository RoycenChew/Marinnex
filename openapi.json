      "post": {
        "description": "Clears the cookie. The token itself stays valid until it expires.\n\nStated rather than hidden: without a session table there is nothing to\ninvalidate, so a token already copied elsewhere survives a logout.",
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
