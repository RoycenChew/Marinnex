# Copy to .env. Never commit the real file: it holds the provider key.
DEEPSEEK_API_KEY=
TOOLKIT_MODEL=deepseek-flash
# Reasoning, per route. Digital gets `on`, the only setting with a 420-document
# result behind it; scans get `repair` (plain first attempt, reasoning on a
# repair). FDIP_EXTRACT_THINKING overrides both when set.
FDIP_EXTRACT_THINKING_DIGITAL=on
FDIP_EXTRACT_THINKING_SCAN=repair
# FDIP_EXTRACT_THINKING=

# Scanned documents are never auto-completed while this is false. Route B
# produced 13 silent errors in 30 mild scans; turn it on only once
# `run_benchmark.py --final` has measured route B.
FDIP_SCAN_AUTO_ACCEPT=false
FDIP_DATA_DIR=./data
FDIP_DB_URL=sqlite:///./data/fdip.db
# Required in every mode, at least 16 characters. The server refuses to start
# without it: a generated pepper would invalidate every API key already issued.
FDIP_KEY_PEPPER=change-me-32-bytes-minimum-pepper
FDIP_SESSION_SECRET=change-me-32-bytes-minimum-secret
FDIP_AI_MONTHLY_CEILING_USD=20
# live     — calls DeepSeek. The only mode that reads a real document.
# recorded — replays a cached response; no network, no spend.
# mock     — canned fixtures for the shipped samples. Never reads the document.
#
# Production refuses `mock` at startup: it answers from fixtures, which in
# front of real users is invented data that looks exactly like a real
# extraction. `recorded` is allowed, and is what a demo should use.
FDIP_PROVIDER_MODE=mock
FDIP_CORS_ORIGINS=http://localhost:5173
FDIP_DEV_SEED=1

# --- production only ---------------------------------------------------------
# Set FDIP_ENV=production and the server tightens several defaults that are
# deliberately loose locally. It then refuses to start without FDIP_KEY_PEPPER,
# FDIP_SESSION_SECRET, DEEPSEEK_API_KEY and FDIP_AI_MONTHLY_CEILING_USD, and
# refuses FDIP_PROVIDER_MODE=mock outright — mock mode answers from canned
# fixtures, which in front of real users would be invented data that looks
# exactly like a real extraction.
#
# On the server these are not written by hand: deploy/scripts/fetch-secrets.sh
# reads them from SSM under /marinnex/prod and writes /srv/marinnex/.env.
FDIP_ENV=development

# Invite only. With this false, /auth/register answers 403 and the UI hides the
# sign-up link and says why. Accounts are made with
# `deploy/scripts/create-user.sh <email>`.
FDIP_ALLOW_REGISTRATION=true

# Per calling address, per minute. Login is the password-guessing bound;
# uploads and /v1/extract share the second one.
FDIP_LOGIN_ATTEMPTS_PER_MINUTE=10
FDIP_UPLOADS_PER_MINUTE=30

# The hostname Caddy obtains a certificate for. `localhost` locally, which
# makes Caddy issue an internal certificate instead of asking Let's Encrypt.
DOMAIN=localhost

# S3 bucket for Litestream (database) and the nightly file sync. The EC2
# instance role supplies the credentials, so there are no keys here.
BACKUP_BUCKET=change-me-marinnex-backups
AWS_REGION=ap-southeast-5
