# The built SPA, served by Caddy. Two stages so Node never reaches the server:
# the runtime image is Caddy plus a folder of static files.
#
# Build context is the parent of this repository, matching Dockerfile.app, so
# one compose file can build both.
ARG APP_DIR=Marinnex

FROM node:22-slim AS build
ARG APP_DIR

WORKDIR /build
# Dependencies first: package.json changes far less often than source, so this
# layer survives most rebuilds.
COPY ${APP_DIR}/web/package.json ${APP_DIR}/web/package-lock.json ./
RUN npm ci

# `src/mocks/handlers.ts` imports ../../../samples/examples.json. The mocks
# never run in this build, but the import is static, so tsc needs the file to
# exist. From /build/src/mocks that path resolves to /samples.
COPY ${APP_DIR}/samples /samples
COPY ${APP_DIR}/web ./
# Same origin in production: Caddy serves the SPA and proxies /v1 to the API,
# so the client needs no absolute API URL and there is no CORS to configure.
ENV VITE_USE_MOCKS=false \
    VITE_API_BASE=""
RUN npm run build


FROM caddy:2-alpine
ARG APP_DIR

COPY --from=build /build/dist /srv/www
COPY ${APP_DIR}/deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
